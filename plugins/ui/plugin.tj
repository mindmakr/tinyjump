// tj:ui: small building blocks for screens, written in tinyjump (docs/language.md, UI).

/// A form field: its label above the control, always visible, and its error below in red
/// when there is one. With an `id`, the error text is `<id>-error`.
export function Field(props: { label: string, error?: string | null, id?: string, children?: any }) {
  const error = props.error === null ? "" : props.error
  return <Column gap={4}>
    <Text weight="bold">{props.label}</Text>
    {props.children}
    {error !== "" && <Text id={props.id === null ? null : `${props.id}-error`} color="#b00020">{error}</Text>}
  </Column>
}

/// A short message for the person: an error in red, or good news in green.
export function Notice(props: { text?: string | null, kind?: "error" | "ok", id?: string }) {
  if (props.text === null || props.text === "") { return null }
  return <Text id={props.id} color={props.kind === "ok" ? "#1b5e20" : "#b00020"}>{props.text}</Text>
}
