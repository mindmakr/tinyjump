// tj:ui: small building blocks for screens, written in tinyjump (docs/language.md, UI).

/// A form field: its label above the control, always visible, and its error below in red
/// when there is one. With an `id`, the error text is `<id>-error`.
export function Field(props: { label: string, error?: string | null, id?: string, children?: any }) {
  const error = props.error === null ? "" : props.error
  const id = props.id === null ? "" : props.id
  // The label also names the control inside, for screen readers and agents.
  return <Column gap={4} label={props.label}>
    <Text weight="bold">{props.label}</Text>
    {props.children}
    {error !== "" && <Text id={id === "" ? null : `${id}-error`} color="#b00020">{error}</Text>}
  </Column>
}

/// The forms waiting for an answer in this run of the app. A restart forgets them, so no form
/// is left waiting for a call it can no longer hear back from.
let formsSending: string[] = []
/// The fields each form shows (`form/field`), so an error for one it does not show goes to
/// the form's own `error` instead of nowhere.
let formsShown: string[] = []

/// A form: what the person typed, its errors, and whether it is waiting for an answer
/// (`Form.get("profile")`). Drafts stay on the device until sent, and go when the person
/// signs out.
export object Form {
  drafts: Record<string, { v: any }> = {}
  errors: Record<string, string> = {}
  error: string = ""

  /// What the input named `name` shows: what the person typed, or else `saved`.
  value(name: string, saved: any): any {
    const d = this.drafts[name]
    return d === null ? saved : d.v
  }

  /// The person typed `v` into `name`: it is kept as a draft, and its error cleared.
  set(name: string, v: any) {
    this.drafts[name] = { v }
    this.errors[name] = ""
  }

  /// Whether it is waiting for `submit`'s answer.
  busy(): boolean {
    return formsSending.includes(this.id)
  }

  /// Runs `action` (check, then call the server), one at a time. When it works, the drafts
  /// go and inputs show the saved values; when it fails, an error from
  /// `check(ok, field, message)` shows at its field when the form shows that field (a
  /// `FormInput`), and any other at the form (`error`).
  async submit(action: () => any) {
    if (this.busy()) { return }
    formsSending.push(this.id)
    this.errors = {}
    this.error = ""
    try {
      await action()
      this.drafts = {}
    } catch (e) {
      if (e.field !== null && formsShown.includes(`${this.id}/${e.field}`)) {
        this.errors[e.field] = e.message
      } else {
        this.error = e.message
      }
    }
    formsSending = formsSending.filter(id => id !== this.id)
  }
}

/// An input bound to a form field: its label, the saved value until the person types, and
/// its error below. Its id is `name` unless given; the error's is `<id>-error`.
export function FormInput(props: { form: Form, name: string, label: string, saved?: any, type?: "text" | "number" | "date" | "time" | "datetime", zone?: string, placeholder?: string, id?: string }) {
  const f = props.form
  const id = props.id === null ? props.name : props.id
  const shown = `${f.id}/${props.name}`
  if (!formsShown.includes(shown)) { formsShown.push(shown) }
  return <Field label={props.label} error={f.errors[props.name]} id={id}>
    <Input id={id} label={props.label} type={props.type} zone={props.zone} placeholder={props.placeholder}
      value={f.value(props.name, props.saved)} onChange={(v) => f.set(props.name, v)} />
  </Field>
}

/// A short message for the person: an error in red, or good news in green.
export function Notice(props: { text?: string | null, kind?: "error" | "ok", id?: string }) {
  if (props.text === null || props.text === "") { return null }
  return <Text id={props.id} color={props.kind === "ok" ? "#1b5e20" : "#b00020"}>{props.text}</Text>
}

/// Per-item actions in flight in this run of the app (`<actions.id>/<key>`). A restart
/// forgets them, so no item is left waiting for a call it can no longer hear back from.
let actionsPending: string[] = []

/// Per-item actions (booking, cancelling, removing rows) that share one error notice:
/// each key runs one at a time, while different keys queue together even offline.
export object Actions {
  error: string = ""

  /// Whether `key` is waiting for its call to finish.
  busy(key: string): boolean {
    return actionsPending.includes(`${this.id}/${key}`)
  }

  /// Runs `action` for `key`, ignoring repeat presses on the same `key` while it is in
  /// flight. Other keys keep working and queue in the outbox while offline.
  async run(key: string, action: () => any) {
    const tag = `${this.id}/${key}`
    if (actionsPending.includes(tag)) { return }
    actionsPending.push(tag)
    this.error = ""
    try {
      await action()
    } catch (e) {
      this.error = e.message
    }
    actionsPending = actionsPending.filter(t => t !== tag)
  }
}
