// A members' club that holds personal data the way the law expects: each purpose names its
// lawful basis, records are erased after two years, members can download or delete their
// own data, and the welcome email goes only to the mail provider the club's pack allows.
// club.pack.json extends the sample GDPR pack with that provider:
//   tj check examples/members/app.tj --compliance examples/members/club.pack.json

import { erase, exportData } from "tj:privacy"

const lawfulBasis = { account: "contract" }

@server @read("owner") @retain("2y") object Member {
  @pii("contact", "account") name: string = ""
  @pii("contact", "account") email: string = ""

  @allow("owner") setName(name: string) { this.name = name.trim() }
  @allow("owner") setEmail(email: string) { this.email = email.trim() }

  @allow("owner") async welcome() {
    await fetch("https://api.mailer.example/send", {
      method: "POST",
      body: JSON.stringify({ to: reveal(this.email, "account"), template: "welcome" }),
    })
  }

  @allow("owner") async myData(): any { return await exportData(caller.id) }

  @allow("owner") async leave() { await erase(caller.id) }
}

function App() {
  if (caller.id === "") {
    return <Column padding={24}><Text>Sign in to see your membership.</Text></Column>
  }
  const me = Member.get(caller.id)
  return <Column padding={24} gap={12}>
    <Text size={24} weight="bold">Members</Text>
    <Input id="name" value={me.name} placeholder="Your name" onSubmit={(t) => me.setName(t)} />
    <Input id="email" value={me.email} placeholder="Your email" onSubmit={(t) => me.setEmail(t)} />
    <Row gap={8}>
      <Button id="welcome" onPress={() => me.welcome()}>Send me the welcome email</Button>
      <Button id="download" onPress={() => me.myData()}>Download my data</Button>
      <Button id="leave" onPress={() => me.leave()}>Delete my account</Button>
    </Row>
  </Column>
}
