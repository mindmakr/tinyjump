// A cart: lines, totals, checkout, and a durable timer that returns held stock to the
// shelf when a cart is left alone.

import { Shelf } from "./shelf"

type Line = { sku: string, name: string, price: number, qty: number }

const HOLD_MS = 10 * 60 * 1000

// One shared demo cart: anyone may read it and shop. `name` is a display name people choose;
// with sign-in, per-user carts would be `Cart.get(caller.id)` with @read("owner").
export @server @read("anyone") object Cart {
  lines: Line[] = []
  status: "open" | "checked out" | "released" = "open"
  total: number = 0
  changedBy: string = ""
  changedAt: number = 0

  @allow("anyone") add(sku: string, name: string) {
    this.mustBeOpen()
    const shelf = Shelf.get("main")
    const product = shelf.products.find(p => p.sku === sku)
    if (product === null) { throw new Error(`no product '${sku}'`) }
    if (!shelf.take(sku)) { throw new Error(`${product.name} is out of stock`) }
    const line = this.lines.find(l => l.sku === sku)
    if (line === null) {
      this.lines.push({ sku, name: product.name, price: product.price, qty: 1 })
    } else {
      line.qty += 1
    }
    this.changed(name)
  }

  @allow("anyone") remove(sku: string, name: string) {
    this.mustBeOpen()
    const line = this.lines.find(l => l.sku === sku)
    if (line === null) { return }
    line.qty -= 1
    if (line.qty === 0) { this.lines = this.lines.filter(l => l.sku !== sku) }
    Shelf.get("main").give(sku, 1)
    this.changed(name)
  }

  @allow("anyone") checkout(name: string): number {
    this.mustBeOpen()
    if (this.lines.length === 0) { throw new Error("the cart is empty") }
    this.status = "checked out"
    this.changed(name)
    this.emit("checkedOut", { total: this.total, by: name })
    return this.total
  }

  @allow("anyone") startOver(name: string) {
    this.release()
    this.status = "open"
    this.changed(name)
  }

  private mustBeOpen() {
    if (this.status !== "open") { throw new Error(`the cart is ${this.status}; start a new one`) }
  }

  private changed(by: string) {
    this.total = this.lines.reduce((sum, l) => sum + l.price * l.qty, 0)
    this.changedBy = by
    this.changedAt = Date.now()
    // A durable timer: if nobody touches the cart, its held stock goes back on the shelf.
    if (this.status === "open" && this.lines.length > 0) { this.schedule(HOLD_MS, "expire", this.changedAt) }
  }

  private expire(stamp: number) {
    if (this.status !== "open" || this.changedAt !== stamp) { return }
    this.release()
    this.status = "released"
    this.changed("backend")
  }

  private release() {
    if (this.status === "open") {
      for (const l of this.lines) { Shelf.get("main").give(l.sku, l.qty) }
    }
    this.lines = []
  }
}
