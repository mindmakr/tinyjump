// A durable cart shared by every device, the backend, the HTTP API and AI agents.
// Change it from any of them and every subscribed screen updates at once.
//
//   UI:      any browser, Android or iOS device running this app
//   API:     curl -X POST localhost:4700/api/Cart/demo/add -H 'content-type: application/json' //                 -d '["tea", "curl"]'   (staff with an API key may also restock: see shelf.tj)
//   Agent:   tj mcp, then call Cart/demo add ["mug", "agent"]
//   Backend: held stock returns to the shelf when a cart is left alone,
//            and the shelf restocks itself every minute
//
// The app is four files: shelf.tj (stock), cart.tj (the cart workflow), assistant.tj (a shop
// assistant on a language model, through the tj:ai plugin) and this one (this device's
// shopper and the screen).

import { Shelf } from "./shelf"
import { Cart } from "./cart"
import { Assistant } from "./assistant"

/// This device's shopper: their name and the last error, kept locally.
object Shopper {
  name: string = ""
  error: string = ""
  question: string = ""

  rename(name: string) { this.name = name }
  setQuestion(text: string) { this.question = text }

  async ask() {
    const q = this.question
    this.question = ""
    await this.attempt(() => Assistant.get("demo").ask(q, this.who()))
  }

  async add(sku: string) { await this.attempt(() => Cart.get("demo").add(sku, this.who())) }
  async remove(sku: string) { await this.attempt(() => Cart.get("demo").remove(sku, this.who())) }
  async checkout() { await this.attempt(() => Cart.get("demo").checkout(this.who())) }
  async startOver() { await this.attempt(() => Cart.get("demo").startOver(this.who())) }

  private who(): string {
    const name = this.name.trim()
    return name === "" ? "a shopper" : name
  }

  private async attempt(action: () => any) {
    try {
      await action()
      this.error = ""
    } catch (e) {
      this.error = e.message
    }
  }
}

function money(n: number): string {
  return `$${n.toFixed(2)}`
}

function App() {
  const shelf = Shelf.get("main")
  const cart = Cart.get("demo")
  const me = Shopper.get("me")
  const assistant = Assistant.get("demo")
  const open = cart.status === "open"

  return <Column padding={20} gap={14}>
    <Row justify="between">
      <Text size={24} weight="bold">Durable cart</Text>
      <Text id="status" color="#555">{cart.status}</Text>
    </Row>
    <Input id="name" value={me.name} placeholder="Your name" onChange={(t) => me.rename(t)} />

    <Text weight="bold">Shelf</Text>
    {shelf.products.map(p => <Row key={p.sku} gap={10}>
      <Text grow={1}>{p.name}</Text>
      <Text color="#555">{money(p.price)}</Text>
      <Text color="#555" id={`stock-${p.sku}`}>{p.stock} left</Text>
      <Button id={`add-${p.sku}`} disabled={!open || p.stock === 0} onPress={() => me.add(p.sku)}>Add</Button>
    </Row>)}

    <Text weight="bold">Cart</Text>
    {cart.lines.map(l => <Row key={l.sku} gap={10}>
      <Text grow={1}>{l.qty} × {l.name}</Text>
      <Text>{money(l.price * l.qty)}</Text>
      <Button id={`remove-${l.sku}`} disabled={!open} onPress={() => me.remove(l.sku)}>Remove</Button>
    </Row>)}
    {cart.lines.length === 0 && <Text color="#555">Nothing in the cart.</Text>}

    <Row justify="between">
      <Text id="total" size={20} weight="bold">{money(cart.total)}</Text>
      {open
        ? <Button id="checkout" disabled={cart.lines.length === 0} onPress={() => me.checkout()}>Check out</Button>
        : <Button id="start-over" onPress={() => me.startOver()}>New cart</Button>}
    </Row>
    {cart.changedBy !== "" && <Text id="changed-by" color="#555">Last change by {cart.changedBy}</Text>}

    <Text weight="bold">Assistant</Text>
    {assistant.lines.slice(-6).map((l, i) => <Text key={i} color={l.who === "assistant" ? "#14532d" : "#333"}>{l.who}: {l.text}</Text>)}
    <Row gap={8}>
      <Input id="question" grow={1} value={me.question} placeholder="Ask, e.g. two teas please" onChange={(t) => me.setQuestion(t)} onSubmit={() => me.ask()} />
      <Button id="ask" disabled={me.question.trim() === ""} onPress={() => me.ask()}>Ask</Button>
    </Row>
    {me.error !== "" && <Text id="error" color="#b00020">{me.error}</Text>}
  </Column>
}
