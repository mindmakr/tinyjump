// A shop assistant: ask in plain words ("two teas, please") and it changes the shared cart
// through the app's own methods. It runs on tj:agent, so every tool call is checked as the
// person who asked: anyone may shop through it, but only staff may restock, exactly as
// without it. The model runs through the tj:ai plugin on the server, so the API key never
// reaches a device (see plugins.json).

import { act, Skill } from "tj:agent"
import { Message } from "tj:ai"
import { Cart } from "./cart"
import { Shelf } from "./shelf"

type ChatLine = { who: string, text: string }

const SKU = { type: "object", properties: { sku: { type: "string", description: "the product's sku" } }, required: ["sku"] }
const RESTOCK = {
  type: "object",
  properties: { sku: { type: "string", description: "the product's sku" }, qty: { type: "number", description: "units to add, 1 to 100" } },
  required: ["sku", "qty"],
}
const MAX_STEPS = 6

/// What the assistant may do, for a shopper called `name`: the cart's own methods. The
/// shopper's name is fixed here, so the model cannot choose it.
function skills(name: string): Skill[] {
  const by = { name: `${name} (via the assistant)` }
  return [
    { name: "add", object: "Cart/demo", method: "add", description: "Put one unit of a product in the shared cart.", params: ["sku", "name"], input: SKU, fixed: by },
    { name: "remove", object: "Cart/demo", method: "remove", description: "Take one unit of a product out of the shared cart.", params: ["sku", "name"], input: SKU, fixed: by },
    { name: "restock", object: "Shelf/main", method: "stock", description: "Add units of a product to the shelf. Only staff may.", params: ["sku", "qty"], input: RESTOCK, fixed: {} },
  ]
}

/// The model's side of the conversation. It holds the model's raw turns, so it has no
/// @read rule: only server code sees it.
@server object AssistantMemory {
  messages: Message[] = []
  keep(messages: Message[]) { this.messages = messages }
  forget() { this.messages = [] }
}

/// What everyone sees: questions and answers.
export @server @read("anyone") object Assistant {
  lines: ChatLine[] = []

  /// `name` is the shopper's display name. @exclusive: one conversation turn at a time, so
  /// two shoppers asking at once take turns instead of mixing up the model's memory. The
  /// tools the agent calls run in this call's chain, so they never wait for it.
  @allow("anyone") @exclusive async ask(question: string, name: string) {
    const q = question.trim()
    if (q === "") { throw new Error("ask something first") }
    this.say(name, q)
    const memory = AssistantMemory.get(this.id)
    try {
      const turn = await act(this.instructions(), memory.messages.concat([{ role: "user", text: q }]), skills(name), MAX_STEPS)
      memory.keep(turn.messages)
      this.say("assistant", turn.text === "" ? "Done." : turn.text)
    } catch (e) {
      // A broken turn could leave a tool call without its result; start the conversation over.
      memory.forget()
      this.say("assistant", `Sorry, I could not answer: ${e.message}`)
    }
  }

  private instructions(): string {
    const products = Shelf.get("main").products.map(p => ({ sku: p.sku, name: p.name, price: p.price, stock: p.stock }))
    return "You are the assistant of a small tea shop. Change the shared cart with the tools when asked. " +
      `Products: ${JSON.stringify(products)}. Cart now: ${JSON.stringify(Cart.get("demo").lines)}. ` +
      "If a tool says you are not allowed, say so plainly. Answer in one or two short sentences."
  }

  private say(who: string, text: string) {
    this.lines.push({ who, text })
    if (this.lines.length > 20) { this.lines.shift() }
  }
}
