// Opt-in 3D scene showcase (`tj-gfx` on wgpu / WebGL2) with `@frame(dt)` animation and `<Mesh onPress>`.

object Stage {
  angle: number = 0
  speed: number = 1.2
  paused: boolean = false
  clicks: number = 0
  wireframe: boolean = false

  @frame step(dt: number) {
    if (!this.paused) {
      this.angle += dt * this.speed
    }
  }

  togglePause() { this.paused = !this.paused }
  toggleWireframe() { this.wireframe = !this.wireframe }
  clickCube() { this.clicks += 1 }
  reset() {
    this.angle = 0
    this.clicks = 0
    this.paused = false
    this.wireframe = false
  }
}

function App() {
  const s = Stage.get("main")
  const bob = Math.sin(s.angle * 2) * 0.25
  const orbitX = Math.cos(s.angle) * 2.2
  const orbitZ = Math.sin(s.angle) * 2.2

  return <Column padding={16} gap={12}>
    <Row justify="between" align="center" gap={8}>
      <Text id="title" size={20} weight="bold">TinyJump 3D Scene</Text>
      <Text id="clicks" color="#4b5563">Cube clicks: {s.clicks}</Text>
    </Row>

    <Scene id="viewport" clear="#0f172a" ambient={0.28} antialias={true} height={340} radius={12}>
      <Camera position={[0, 2.1, 5.4]} target={[0, 0, 0]} fov={45} />
      <Light kind="directional" direction={[-0.4, -1.0, -0.5]} color="#ffffff" intensity={1.25} />
      <Light kind="point" position={[orbitX, 2.0, orbitZ]} color="#38bdf8" intensity={1.8} />

      <Mesh
        id="hero-cube"
        geometry="box"
        position={[0, bob, 0]}
        rotation={[0.35, s.angle, 0.15]}
        scale={1.35}
        color={s.clicks % 2 === 0 ? "#ef4444" : "#f59e0b"}
        metallic={0.25}
        roughness={0.35}
        wireframe={s.wireframe}
        onPress={() => s.clickCube()}
      >
        <Mesh
          id="moon"
          geometry="sphere"
          position={[1.55, 0.35, 0]}
          scale={0.42}
          color="#22c55e"
          roughness={0.3}
        />
      </Mesh>

      <Mesh
        id="pillar"
        geometry="cylinder"
        position={[-2.1, -0.45, -0.8]}
        scale={[0.6, 1.3, 0.6]}
        color="#6366f1"
        metallic={0.4}
        roughness={0.4}
      />

      <Mesh
        id="pyramid"
        geometry="pyramid"
        position={[2.0, -0.55, -0.9]}
        rotation={[0, -s.angle * 0.7, 0]}
        scale={0.95}
        color="#eab308"
      />

      <Mesh
        id="floor"
        geometry="plane"
        position={[0, -1.15, 0]}
        scale={[9, 1, 9]}
        color="#1e293b"
        roughness={0.85}
      />
    </Scene>

    <Row gap={8}>
      <Button id="pause" onPress={() => s.togglePause()}>{s.paused ? "Resume" : "Pause"}</Button>
      <Button id="wire" onPress={() => s.toggleWireframe()}>{s.wireframe ? "Solid" : "Wireframe"}</Button>
      <Button id="reset" onPress={() => s.reset()}>Reset</Button>
    </Row>
  </Column>
}
