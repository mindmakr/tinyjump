# Deterministic trace test for examples/collab-studio/app.tj
{"do": "boot", "now": 1800000000000, "seed": 1, "server": true, "render": true}
{"do": "assertScreen", "contains": ["TinyJump Studio", "Room studio", "Join Video", "Voice Only"]}
{"do": "assertLayout", "width": 390, "height": 844, "review": true}

# Join room + toggle screen share; durable activity recorded via this.deliver
{"do": "call", "object": "StudioRoom/studio", "method": "join", "args": ["Alice"], "expect": ["Alice"]}
{"do": "call", "object": "StudioRoom/studio", "method": "join", "args": ["Bob"], "expect": ["Alice", "Bob"]}
{"do": "call", "object": "StudioRoom/studio", "method": "setScreenShare", "args": ["Alice", true], "expect": "Alice"}
{"do": "call", "object": "StudioRoom/studio", "method": "setScreenShare", "args": ["Bob", true], "expectError": "already sharing"}
{"do": "call", "object": "StudioRoom/studio", "method": "setScreenShare", "args": ["Alice", false], "expect": ""}

# Room-isolated chat & whiteboard strokes (`ChatEntry.all("studio:")` vs `"other:"`)
{"do": "call", "object": "StudioRoom/studio", "method": "postChat", "args": ["Alice", "Hello studio"], "expect": 1}
{"do": "call", "object": "StudioRoom/other", "method": "postChat", "args": ["Eve", "Secret other room"], "expect": 1}
{"do": "call", "object": "StudioRoom/studio", "method": "addStroke", "args": ["Alice", "#111114", 3, [10, 20, 120, 240]], "expect": 1}
{"do": "call", "object": "StudioRoom/studio", "method": "addStroke", "args": ["Bob", "#9a3412", 6, [300, 320, 500, 520]], "expect": 2}
{"do": "call", "object": "StudioRoom/other", "method": "addStroke", "args": ["Eve", "#1d4ed8", 4, [50, 50, 90, 90]], "expect": 1}
{"do": "call", "object": "StudioRoom/studio", "method": "undoStroke", "args": ["Alice"], "expect": true}
{"do": "get", "object": "BoardStroke/studio:000001", "expectContains": {"points": []}}
{"do": "get", "object": "BoardStroke/studio:000002", "expectContains": {"author": "Bob"}}

# Verify durable RoomActivity received all cross-object delivered events in studio only
{"do": "get", "object": "RoomActivity/studio", "expectContains": {"nextSeq": 9}}
{"do": "get", "object": "RoomActivity/other", "expectContains": {"nextSeq": 3}}
{"do": "get", "object": "ChatEntry/studio:000001", "expectContains": {"author": "Alice", "text": "Hello studio"}}

# Clear studio board fans out durable deletes across remaining BoardStroke/studio:* while leaving other room untouched
{"do": "call", "object": "StudioRoom/studio", "method": "clearBoard", "args": ["Alice"], "expect": 1}
{"do": "get", "object": "BoardStroke/studio:000002", "expectContains": {"points": []}}
{"do": "get", "object": "BoardStroke/other:000001", "expectContains": {"author": "Eve"}}

# Switch to Board as a guest (before entering a name) and draw via onStroke, then test pen controls, undo, and clear
{"do": "ui", "target": "#tabs", "event": "onChange", "value": "board"}
{"do": "assertScreen", "contains": ["Strokes (studio): 0"]}
{"do": "ui", "target": "#whiteboard", "event": "onColorChange", "value": "#1d4ed8"}
{"do": "ui", "target": "#whiteboard", "event": "onWidthChange", "value": 8}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"penColor": "#1d4ed8", "penWidth": 8}}
{"do": "ui", "target": "#whiteboard", "event": "onStroke", "value": {"color": "#0f766e", "width": 4, "points": [40, 40, 220, 180]}}
{"do": "assertScreen", "contains": ["Strokes (studio): 1"]}
{"do": "ui", "target": "#whiteboard", "event": "onUndo"}
{"do": "assertScreen", "contains": ["Strokes (studio): 0"]}
{"do": "ui", "target": "#whiteboard", "event": "onStroke", "value": {"color": "#1d4ed8", "width": 8, "points": [20, 20, 160, 140]}}
{"do": "assertScreen", "contains": ["Strokes (studio): 1"]}
{"do": "ui", "target": "#whiteboard", "event": "onClear"}
{"do": "assertScreen", "contains": ["Strokes (studio): 0"]}
{"do": "assertLayout", "width": 390, "height": 844, "review": true}
{"do": "ui", "target": "#tabs", "event": "onChange", "value": "chat"}
{"do": "assertScreen", "contains": ["Hello studio"]}
{"do": "assertLayout", "width": 390, "height": 844, "review": true}
{"do": "ui", "target": "#tabs", "event": "onChange", "value": "activity"}
{"do": "assertScreen", "contains": ["Durable Room Activity", "Alice"]}
{"do": "assertLayout", "width": 390, "height": 844, "review": true}
{"do": "ui", "target": "#tabs", "event": "onChange", "value": "call"}
{"do": "ui", "target": "#reset-room", "event": "onPress"}
{"do": "ui", "target": "#name-input", "event": "onChange", "value": "Carol"}
{"do": "ui", "target": "#join-audio", "event": "onPress"}
{"do": "assertScreen", "contains": ["End Call", "Share Screen", "Peers: Carol"]}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"inCall": true, "videoEnabled": false}}
{"do": "ui", "target": "#video-call", "event": "onMediaMode", "value": "audio-only"}
{"do": "ui", "target": "#video-call", "event": "onNotice", "value": "Camera unavailable — joined audio-only"}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"mediaMode": "audio-only", "callNotice": "Camera unavailable — joined audio-only"}}
{"do": "assertScreen", "contains": ["Camera unavailable"]}
{"do": "call", "object": "StudioRoom/studio", "method": "join", "args": ["Alice"], "expect": ["Carol", "Alice"]}
{"do": "call", "object": "StudioRoom/studio", "method": "setScreenShare", "args": ["Alice", true], "expect": "Alice"}
{"do": "ui", "target": "#toggle-screen", "event": "onPress"}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"screenShare": false, "lastError": "Alice is already sharing their screen"}}
{"do": "assertScreen", "contains": ["Alice is already sharing"]}
{"do": "call", "object": "StudioRoom/studio", "method": "setScreenShare", "args": ["Alice", false], "expect": ""}
{"do": "call", "object": "StudioRoom/studio", "method": "leave", "args": ["Alice"], "expect": ["Carol"]}
{"do": "ui", "target": "#video-call", "event": "onScreenShare", "value": true}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"screenShare": true}}
{"do": "get", "object": "StudioRoom/studio", "expectContains": {"screenSharer": "Carol"}}
{"do": "ui", "target": "#video-call", "event": "onScreenShare", "value": false}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"screenShare": false}}
{"do": "get", "object": "StudioRoom/studio", "expectContains": {"screenSharer": ""}}
{"do": "ui", "target": "#toggle-screen", "event": "onPress"}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"screenShare": true}}
{"do": "ui", "target": "#tabs", "event": "onChange", "value": "board"}
{"do": "assertScreen", "contains": ["Strokes (studio): 0"]}
{"do": "assertLayout", "width": 390, "height": 844, "review": true}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"inCall": true}}
{"do": "ui", "target": "#tabs", "event": "onChange", "value": "call"}
{"do": "assertScreen", "contains": ["End Call", "Peers: Carol"]}
{"do": "ui", "target": "#leave-call", "event": "onPress"}
{"do": "get", "object": "StudioLocal/me", "expectContains": {"inCall": false}}

{"do": "call", "object": "StudioRoom/studio", "method": "undoStroke", "args": ["12345678901234567890123456789012345678901"], "expectError": "1-40 characters"}

# Restart persistence over the same store keeps topic entries and activity
{"do": "boot", "restart": true, "now": 1800000005000, "seed": 1, "server": true, "render": true}
{"do": "get", "object": "ChatEntry/studio:000001", "expectContains": {"text": "Hello studio"}}
{"do": "get", "object": "RoomActivity/studio", "expectContains": {"nextSeq": 22}}
